# ─── Data & ML Artifacts ──────────────────────────────────────────────────────
# Raw & processed data — never commit to git
data/

# Model weights (besar, di-mount via Docker volume atau didownload saat deployment)
models/*.keras
models/*.h5
models/*.hdf5
*.keras
*.h5
*.tfrecord

# Training output artifacts — di-generate oleh src/train.py, tidak perlu di-commit
# Jalankan python src/train.py untuk men-generate kembali file-file ini
models/*.json
models/*.png

# ─── Logs & Caches ────────────────────────────────────────────────────────────
logs/
*.log
*.db
mlruns/
.pytest_cache/

# ─── Docker ───────────────────────────────────────────────────────────────────
.docker/

